# Copy to backend-fastapi/.env (or set these in the systemd unit). Do not commit the real .env.
DATABASE_URL=postgres://fif:TOPSECRET@localhost:5432/fif
# Admin routes (document ingestion, summaries, cache). Generate with: openssl rand -hex 32
FIF_ADMIN_TOKEN=
# Comma-separated browser origins allowed to call the API (empty = same origin only)
FIF_CORS_ORIGINS=
FIF_RATE_LIMIT_PER_MIN=600
PG_POOL_MAX=10
# Where downloaded NASA PSI PDFs are stored
FIF_DOCUMENTS_DIR=/var/lib/flame-in-freefall/psi-docs
# Optional: grounded Claude answers and summaries (extractive answers work without it)
ANTHROPIC_API_KEY=
FIF_MODEL=claude-opus-5-5

# Accounts: sign up, email verification, sign in.
# Public address of the site, used in the links inside emails (empty = taken from the request)
FIF_PUBLIC_URL=
FIF_SESSION_DAYS=30
# Outgoing email. Leave SMTP_HOST empty in development: verification links are then written to the server log.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=your address, SMTP_PASSWORD=a Google App password (not your normal password),
# SMTP_FROM=Flame in Freefall <your address>. Put real values ONLY in .env, never in this file.
# SMTP_SECURITY: ssl (port 465, recommended) or starttls (port 587); none only for a local test server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# FlameAtlas API (team service: RAG /ask, AHP /rank, droplet /predict), served on this site under /api/v1/atlas.
# Use the address of the FlameAtlas API itself (its uvicorn port shared through ngrok), not the Streamlit app.
FLAMEATLAS_URL=
FLAMEATLAS_TIMEOUT=60

# React dashboard (frontend/): its address, used by "Continue to login" on the verification and reset pages (empty = this site's /login)
FIF_FRONTEND_URL=
# Browser origins of the React dashboard allowed by CORS (default: the Vite dev server)
FIF_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
