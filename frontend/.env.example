# Option A: backend on your machine (default is http://localhost:8000 if nothing is set)
VITE_API_URL=http://localhost:8000

# Option B: backend on a teammate's machine through ngrok (or any remote URL).
# The Vite dev server proxies /backend to it, which avoids CORS and ngrok's warning page.
# BACKEND_PROXY_TARGET=https://your-tunnel.ngrok-free.dev
# VITE_API_URL=/backend
